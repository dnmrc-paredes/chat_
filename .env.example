# Absolute origin of the deployed site, used to build canonical and Open Graph
# URLs. Falls back to http://localhost:3000 when unset.
NEXT_PUBLIC_SITE_URL=

# Supabase project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key (newer format: sb_publishable_...) or legacy anon JWT
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=